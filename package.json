{
  "name": "aurafront_vue",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:analyze": "vue-cli-service build --report",
    "test": "node --test tests/unit/*.spec.js",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.1.1",
    "@vuepic/vue-datepicker": "14.0.0",
    "axios": "^1.16.0",
    "core-js": "^3.8.3",
    "date-fns": "4.4.0",
    "exceljs": "^4.4.0",
    "sockjs-client": "^1.6.1",
    "sweetalert2": "^11.21.2",
    "vue": "^3.2.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^8.0.3",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "no-console": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "cross-spawn": "^7.0.3",
    "postcss": "^8.4.31",
    "webpack-dev-server": "^5.2.1"
  }
}
